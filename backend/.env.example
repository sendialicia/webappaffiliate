# Copy to .env and fill in.
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SECURE=false

DATABASE_URL=postgres://user:password@localhost:5432/affiliate_comments

# Must match frontend/.env.local. Only the Next.js proxy route may call this API.
INTERNAL_API_SECRET=
# Optional: comma-separated origins allowed to call this API from a browser directly.
# CORS_ORIGIN=
