# Copy to .env.local and fill in. Never prefix secrets with NEXT_PUBLIC_ — those ship to the browser.

# Backend URL for the snapshot capture script only; the app itself goes through /api/backend.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Microsoft SSO (from IT: app registration dataapp-affiliate-analytics)
AZURE_AD_CLIENT_ID=
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_SECRET=
# Generate: openssl rand -base64 32
AUTH_SECRET=

# Where the proxy route forwards data calls, and the secret it proves itself with.
# INTERNAL_API_SECRET must match backend/.env. Generate: openssl rand -hex 32
BACKEND_URL=http://localhost:4000
INTERNAL_API_SECRET=
